#version 150

uniform mat4 ModelViewMat;
uniform mat4 ProjMat;

uniform float NostrumTime;

in vec3 Position;
in vec4 Color;
in vec2 UV0;
in ivec2 UV2;

out vec4 vertexColor;
out vec2 texCoord0;
out vec2 lightCoord;


/*
 * ============================================================
 * Utility
 * ============================================================
 */

float hash(float x)
{
    return fract(
            sin(x * 127.1)
            * 43758.5453123
    );
}


/*
 * ============================================================
 * Main
 * ============================================================
 */

void main()
{
    vec3 pos = Position;


    /*
     * --------------------------------------------------------
     * 疑似的な文字ID
     *
     * 同じ文字の4頂点には同じ値が入るようにする。
     * --------------------------------------------------------
     */

    float glyphId =
    floor(
            Position.x * 16.0
    );


    float random =
    hash(glyphId);


    float phase =
    random * 6.28318530718;


    /*
     * --------------------------------------------------------
     * 1. 静かな浮遊
     *
     * 「文字が存在している」というより
     * 空間に漂っているような動き。
     * --------------------------------------------------------
     */

    float floatWave =
    sin(
            NostrumTime * 0.65
            + phase
    );


    pos.y +=
    floatWave
    * 0.18;


    /*
     * --------------------------------------------------------
     * 2. 微細な横揺れ
     *
     * かなり小さくする。
     *
     * 「揺れている」ではなく
     * 「位置がほんの少し不安定」
     * くらい。
     * --------------------------------------------------------
     */

    float drift =
    sin(
            NostrumTime * 0.43
            + phase * 1.73
    );


    pos.x +=
    drift
    * 0.055;


    /*
     * --------------------------------------------------------
     * 3. 文字ごとの遅延
     *
     * 文字列の中で終焉がゆっくり伝播する。
     * --------------------------------------------------------
     */

    float endingWave =
    sin(
            NostrumTime * 0.34
            - glyphId * 0.75
    );


    float ending =
    smoothstep(
            0.72,
            1.0,
            endingWave
    );


    /*
     * --------------------------------------------------------
     * 4. 最後へ沈む
     *
     * 一定周期で、文字がほんの少しだけ
     * 下へ引っ張られる。
     *
     * 「崩壊」ではなく「終わり」。
     * --------------------------------------------------------
     */

    pos.y -=
    ending
    * 0.22;


    /*
     * --------------------------------------------------------
     * 5. 微細な傾き感
     *
     * 実際に回転させるのではなく、
     * X方向の変位を上下で変えることで
     * 少しだけ文字が揺れているように見せる。
     * --------------------------------------------------------
     */

    float tilt =
    sin(
            NostrumTime * 0.52
            + phase
    )
    * 0.018;


    pos.x +=
    (Position.y - floor(Position.y))
    * tilt;


    /*
     * --------------------------------------------------------
     * 6. 最後の瞬間
     *
     * 非常に長い周期で、
     * 一瞬だけ文字がわずかに沈む。
     *
     * 普段はほぼ気付かない。
     * --------------------------------------------------------
     */

    float finalMoment =
    pow(
            0.5 +
            0.5 *
            sin(
                    NostrumTime * 0.16
                    + random * 2.0
            ),
            14.0
    );


    pos.y -=
    finalMoment
    * 0.12;


    /*
     * --------------------------------------------------------
     * Vertex
     * --------------------------------------------------------
     */

    gl_Position =
    ProjMat
    * ModelViewMat
    * vec4(
            pos,
            1.0
    );


    /*
     * --------------------------------------------------------
     * Minecraft Font data
     * --------------------------------------------------------
     */

    vertexColor =
    Color;

    texCoord0 =
    UV0;

    lightCoord =
    vec2(
            float(UV2.x) / 256.0,
            float(UV2.y) / 256.0
    );
}