#version 150

uniform sampler2D Sampler0;
uniform sampler2D Sampler2;

uniform float NostrumTime;
uniform float Speed;
uniform float Intensity;

uniform vec3 ColorA;
uniform vec3 ColorB;

in vec4 vertexColor;
in vec2 texCoord0;
in vec2 lightCoord;

out vec4 fragColor;


/*
 * ============================================================
 * Utility
 * ============================================================
 */

float hash(vec2 p)
{
    return fract(
            sin(
                    dot(
                            p,
                            vec2(127.1, 311.7)
                    )
            ) * 43758.5453123
    );
}


float noise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);

    f = f * f * (3.0 - 2.0 * f);

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));

    return mix(
            mix(a, b, f.x),
            mix(c, d, f.x),
            f.y
    );
}


/*
 * ============================================================
 * Fragment
 * ============================================================
 */

void main()
{
    vec4 texel = texture(
            Sampler0,
            texCoord0
    );

    if (texel.a <= 0.01)
    discard;


    /*
     * --------------------------------------------------------
     * Time
     *
     * 「時計が最後の時を刻む」
     * --------------------------------------------------------
     */

    float time =
    NostrumTime * Speed;


    /*
     * --------------------------------------------------------
     * 基本UV
     * --------------------------------------------------------
     */

    vec2 uv = texCoord0;


    /*
     * --------------------------------------------------------
     * ゆっくりと沈む時間
     *
     * 上から下へ、
     * 何かが終わっていくように流れる。
     * --------------------------------------------------------
     */

    float endingWave =
    uv.y
    + time * 0.025;


    float ending =
    0.5
    + 0.5 * sin(
            endingWave * 8.0
            - time * 0.45
    );


    /*
     * --------------------------------------------------------
     * 時間の「揺らぎ」
     *
     * 完全に規則的ではなく、
     * 古いフィルムのような不安定さ。
     * --------------------------------------------------------
     */

    float slowNoise =
    noise(
            uv * 4.0
            + vec2(
                    time * 0.018,
                    -time * 0.012
            )
    );


    float fineNoise =
    noise(
            uv * 17.0
            + vec2(
                    -time * 0.035,
                    time * 0.02
            )
    );


    /*
     * --------------------------------------------------------
     * 世界が少しずつ崩れていくような濃淡
     * --------------------------------------------------------
     */

    float decay =
    smoothstep(
            0.15,
            0.9,
            slowNoise
    );


    /*
     * --------------------------------------------------------
     * ColorA / ColorB
     *
     * ここでは「鮮やかな色」ではなく、
     * 二つの記憶が混ざって消えていくイメージ。
     * --------------------------------------------------------
     */

    float memory =
    0.5
    + 0.5 * sin(
            uv.x * 4.0
            - uv.y * 2.0
            + time * 0.12
    );


    vec3 memoryColor =
    mix(
            ColorA,
            ColorB,
            memory
    );


    /*
     * --------------------------------------------------------
     * 彩度を少しずつ失わせる。
     *
     * 「物語が終わる」感じの重要部分。
     * --------------------------------------------------------
     */

    float luminance =
    dot(
            memoryColor,
            vec3(
                    0.299,
                    0.587,
                    0.114
            )
    );


    vec3 fadedColor =
    mix(
            vec3(luminance),
            memoryColor,
            0.32
    );


    /*
     * --------------------------------------------------------
     * 終焉の波
     *
     * たまに文字全体を静かに横切る。
     * --------------------------------------------------------
     */

    float finalPass =
    exp(
            -pow(
                    (ending - 0.5) * 4.0,
                    2.0
            )
    );


    /*
     * --------------------------------------------------------
     * 最後に残る光
     *
     * 完全な白ではなく、
     * 「遠くに残った記憶」のような光。
     * --------------------------------------------------------
     */

    float lastLight =
    pow(
            finalPass,
            3.5
    );


    /*
     * --------------------------------------------------------
     * 微細な粒子
     *
     * 崩壊の直前に残る小さな光。
     * --------------------------------------------------------
     */

    float fragments =
    smoothstep(
            0.78,
            1.0,
            fineNoise
    );


    /*
     * --------------------------------------------------------
     * 基本色
     * --------------------------------------------------------
     */

    vec3 color =
    fadedColor;


    /*
     * 時間の流れ。
     */

    color *=
    0.92
    + decay * 0.18;


    /*
     * 終焉の波が通った瞬間だけ
     * 少しだけ明るくする。
     */

    color +=
    memoryColor
    * lastLight
    * 0.42
    * Intensity;


    /*
     * 最後の欠片。
     */

    color +=
    vec3(1.0)
    * fragments
    * 0.16
    * Intensity;


    /*
     * --------------------------------------------------------
     * 「最後の一頁」
     *
     * 時間が進むほど、
     * ほんの少しだけ暗くなる。
     *
     * 完全には消えない。
     * --------------------------------------------------------
     */

    float endingFade =
    0.94
    + 0.06 * cos(
            time * 0.18
    );


    color *= endingFade;


    /*
     * --------------------------------------------------------
     * Lightmap
     * --------------------------------------------------------
     */

    vec4 light =
    texture(
            Sampler2,
            lightCoord
    );

    color *= light.rgb;

    color +=
    vec3(
            0.55,
            0.70,
            1.0
    )
    * lastLight
    * 0.20
    * Intensity;


    /*
     * Minecraft vertex color
     * --------------------------------------------------------
     */

    color *= vertexColor.rgb;





    /*
     * --------------------------------------------------------
     * Final
     * --------------------------------------------------------
     */

    fragColor =
    vec4(
            color,
            texel.a
            * vertexColor.a
    );
}