{
  "fluid_amount": 1000,
  "target": "c:tools/melee_weapon",
  "attributes": [],
  "events": [
    {
      "event": "net.neoforged.neoforge.event.entity.living.LivingDamageEvent$Pre",

      "variables": {
        "attacker": "event.getSource().getEntity()",
        "target": "event.getEntity()",
        "stack": "attacker.getMainHandItem()",
        "upgrade": "stack.get(ALCHEMICAL_UPGRADE_COMPONENT)"
      },

      "conditions": [
        "attacker != null",
        "upgrade != null",
        "upgrade.getId() == ResourceLocation.fromNamespaceAndPath(\"nostrum\", \"direct_attack\")"
      ],

      "actions": [
        "target.setHealth(target.getHealth() - event.getNewDamage())",
        "event.setNewDamage(0.0)"
      ]
    }
  ]
}